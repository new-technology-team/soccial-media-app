# API URL - For Android emulator use 10.0.2.2:5000, for iOS simulator use localhost:5000
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000

# Socket URL
EXPO_PUBLIC_SOCKET_URL=http://10.0.2.2:5000

# WebRTC TURN server (tùy chọn) — chỉ cần khi gọi qua NAT đối xứng (4G/CGNAT/mạng công ty).
# Phải trùng cấu hình TURN của web (VITE_TURN_*). Nhiều URL cách nhau bởi dấu phẩy.
# STUN của Google đã cấu hình sẵn nên LAN/emulator không cần TURN.
# EXPO_PUBLIC_TURN_URLS=turn:turn.example.com:3478
# EXPO_PUBLIC_TURN_USERNAME=
# EXPO_PUBLIC_TURN_CREDENTIAL=
